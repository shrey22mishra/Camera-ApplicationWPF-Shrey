<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>ZEISS-Logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ZEISS-Logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenCvSharp packages for webcam capture and image processing -->
    <PackageReference Include="OpenCvSharp4" Version="4.7.0.20230115" />
    <!-- Native runtime for Windows (required for OpenCV native binaries) -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.7.0.20230115" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\haarcascade_frontalface_default.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
