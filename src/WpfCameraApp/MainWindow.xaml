<Window x:Class="WpfCameraApp.MainWindow"
<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WpfCameraApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfCameraApp.ViewModels"
        Title="WpfCameraApp" Height="600" Width="1000" MinHeight="480" MinWidth="800">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Preview area with overlay canvas for face rectangles -->
        <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="4">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" Source="{Binding PreviewImage}" />
                <Canvas IsHitTestVisible="False">
                    <!-- Face rectangles will be drawn here in future -->
                </Canvas>
            </Grid>
        </Border>

        <!-- Controls -->
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock Text="Controls" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Start Camera" Command="{Binding StartCommand}" Width="110" Margin="0,0,8,0" />
                <Button Content="Stop Camera" Command="{Binding StopCommand}" Width="110" Margin="0,0,8,0" />
                <Button Content="Reset" Command="{Binding ResetCommand}" Width="80" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                <Label Content="Filter" />
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                <Label Content="Brightness" />
                <Slider Minimum="-1" Maximum="1" Value="{Binding Brightness, Mode=TwoWay}" TickFrequency="0.1" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                <Label Content="Contrast" />
                <Slider Minimum="0" Maximum="3" Value="{Binding Contrast, Mode=TwoWay}" TickFrequency="0.1" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                <Label Content="Tint" />
                <Slider Minimum="-1" Maximum="1" Value="{Binding Tint, Mode=TwoWay}" TickFrequency="0.1" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,8">
                <CheckBox IsChecked="{Binding DetectFaces, Mode=TwoWay}" Content="Detect Faces" />
            </StackPanel>

            <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,8,0,4" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#333" />

            <StackPanel VerticalAlignment="Bottom" Margin="0,16,0,0">
                <TextBlock FontSize="12" Foreground="#666">Tip: Controls are placeholders until capture is implemented.</TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
