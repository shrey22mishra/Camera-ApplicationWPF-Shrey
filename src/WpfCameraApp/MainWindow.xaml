<Window x:Class="WpfCameraApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:WpfCameraApp.ViewModels"
        Title="Studio Camera" Height="680" Width="1120" MinHeight="540" MinWidth="900"
        Background="{StaticResource PageBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0F172A" CornerRadius="14" Padding="12">
            <Grid>
                <Image x:Name="PreviewImageControl" Stretch="Uniform" Source="{Binding PreviewImage}" SizeChanged="PreviewImageControl_SizeChanged" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,5" Background="#CC0F172A" CornerRadius="12">
                    <TextBlock Text="LIVE PREVIEW" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <Canvas IsHitTestVisible="False" Width="{Binding ActualWidth, ElementName=PreviewImageControl}" Height="{Binding ActualHeight, ElementName=PreviewImageControl}">
                    <ItemsControl ItemsSource="{Binding FaceRects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <!-- ItemsControl wraps each item in a ContentPresenter. Canvas
                             coordinates must be set on that direct child, not the
                             Rectangle inside the data template. -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Stroke="#22C55E" StrokeThickness="2" Fill="Transparent"
                                           Width="{Binding Width}" Height="{Binding Height}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="22,0,0,0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24">
        <StackPanel>
            <TextBlock Text="Studio Camera" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Tune the live feed and detect faces." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,22" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Start" Command="{Binding StartCommand}" Margin="0,0,8,0" />
                <Button Content="Stop" Command="{Binding StopCommand}" Background="#334155" Margin="0,0,8,0" />
                <Button Content="Reset" Command="{Binding ResetCommand}" Background="#E2E8F0" Foreground="#334155" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,14">
                <TextBlock Text="FILTER" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,14">
                <TextBlock Text="BRIGHTNESS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Slider Minimum="-1" Maximum="1" Value="{Binding Brightness, Mode=TwoWay}" TickFrequency="0.1" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,14">
                <TextBlock Text="CONTRAST" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Slider Minimum="0" Maximum="2" Value="{Binding Contrast, Mode=TwoWay}" TickFrequency="0.1" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,20">
                <TextBlock Text="TINT" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Slider Minimum="-1" Maximum="1" Value="{Binding Tint, Mode=TwoWay}" TickFrequency="0.1" />
            </StackPanel>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="ANALYSIS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7" />
                <primitives:ToggleButton IsChecked="{Binding DetectFaces, Mode=TwoWay}" Content="Detect Faces" HorizontalAlignment="Left" />
            </StackPanel>

            <Border Background="#F1F5F9" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="STATUS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
        </Border>
    </Grid>
</Window>
